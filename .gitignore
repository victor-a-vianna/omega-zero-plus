# Rust and cross-device build outputs.
/target/
/target-device/
/target-verify/

# Downloaded core sources, compiled cores and generated distributions.
/vendor/
/dist/
/dist-device/
/sdcard/
/release/
/artifacts/

# Native compiler outputs and profiling data.
*.dylib
*.so
*.dll
*.pdb
*.dSYM/
*.profraw
*.profdata

# Temporary files, logs and local packages.
/tmp/
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.rs.bk
*~
*.zip
*.tar
*.tar.gz
*.tgz

# Local configuration and credentials. Keep documented examples versioned.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.keystore
credentials.json
secrets.json

# Local caches and test output.
.cache/
.pytest_cache/
__pycache__/
coverage/
.coverage
lcov.info

# Editor and operating-system metadata.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local-only assistant and documentation workspaces.
/docs/
/CLAUDE.md
/.ralph/
/.superpowers/

# Parallel implementation worktrees, never content.
/.worktrees

# The console's root password, for scripts/console.sh.
/.console-password

# Playwright MCP snapshots and console logs from browser checks.
/.playwright-mcp/
